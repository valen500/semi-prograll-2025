<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF512F" android:endColor="#DD2476" android:angle="90"/>
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1FA2FF" android:endColor="#12D8FA" android:angle="90"/>
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
