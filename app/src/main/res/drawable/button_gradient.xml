<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#43C6AC" android:endColor="#191654" android:angle="90"/>
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1D2671" android:endColor="#C33764" android:angle="90"/>
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
