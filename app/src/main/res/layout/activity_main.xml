<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Fondo del RecyclerView con margen -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCarros"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/containerBotones"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:clipToPadding="false" />

    <!-- Contenedor de botones con fondo y bordes -->
    <LinearLayout
        android:id="@+id/containerBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_margin="8dp"
        android:background="@drawable/fondo_botones"
        android:elevation="6dp">

        <Button
            android:id="@+id/btnSensores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir a Sensores"
            android:backgroundTint="#03A9F4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:drawableLeft="@android:drawable/ic_menu_compass"
            android:padding="10dp"/>

        <Button
            android:id="@+id/btnAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar Carro"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:drawableLeft="@android:drawable/ic_input_add"
            android:padding="10dp"/>
    </LinearLayout>

</RelativeLayout>
