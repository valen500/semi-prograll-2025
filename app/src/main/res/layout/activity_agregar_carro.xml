<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- EditText: Marca -->
        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marca del carro"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:layout_marginBottom="12dp" />

        <!-- EditText: Modelo -->
        <EditText
            android:id="@+id/etModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Modelo del carro"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:layout_marginBottom="12dp" />

        <!-- EditText: Año -->
        <EditText
            android:id="@+id/etAnio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Año"
            android:inputType="number"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Imagen del carro -->
        <ImageView
            android:id="@+id/imageCarro"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Vista previa del carro" />

        <!-- Botón: Tomar Foto -->
        <Button
            android:id="@+id/btnCamara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Tomar Foto"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:elevation="2dp" />

        <!-- Botón: Seleccionar de Galería -->
        <Button
            android:id="@+id/btnGaleria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖼️ Galería"
            android:background="#03A9F4"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:elevation="2dp" />

        <!-- Botón: Guardar -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Guardar Carro"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:elevation="3dp" />
        <Button
            android:id="@+id/btnGrabarAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grabar Audio"/>

        <Button
            android:id="@+id/btnReproducirAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reproducir Audio"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
