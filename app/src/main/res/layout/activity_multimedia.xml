<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro Físico"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- FECHA -->
        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (dd/mm/aaaa)"
            android:inputType="date"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- PESO -->
        <EditText
            android:id="@+id/etPeso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Peso (kg)"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- BOTONES DE FOTO -->
        <Button
            android:id="@+id/btnTomarFoto"
            style="@style/CustomButton.Primary"
            android:text="📸 Tomar Foto" />

        <Button
            android:id="@+id/btnSeleccionarImagen"
            style="@style/CustomButton.Primary"
            android:text="🖼 Seleccionar Imagen"
            android:layout_marginTop="8dp" />

        <!-- IMAGEN MOSTRADA -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_image_preview" />

        <!-- AUDIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙 Audio"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnGrabarAudio"
                style="@style/CustomButton.Red"
                android:layout_weight="1"
                android:text="Grabar" />

            <Button
                android:id="@+id/btnDetenerGrabacion"
                style="@style/CustomButton.Gray"
                android:layout_weight="1"
                android:text="Detener"
                android:enabled="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReproducirAudio"
            style="@style/CustomButton.Green"
            android:text="▶ Reproducir Audio"
            android:layout_marginTop="10dp" />

        <!-- VIDEO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎥 Video"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReproducirVideo"
            style="@style/CustomButton.Blue"
            android:text="▶ Reproducir Video"
            android:layout_marginTop="8dp" />

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"
            android:background="#000000" />

        <!-- GUARDAR -->
        <Button
            android:id="@+id/btnGuardarRegistro"
            style="@style/CustomButton.Green"
            android:text="💾 Guardar Registro"
            android:layout_marginTop="20dp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
