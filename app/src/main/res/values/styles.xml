<resources>
    <!-- Estilo base -->
    <style name="CustomButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/rounded_button</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo primario -->
    <style name="CustomButton.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#3F51B5</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Estilos secundarios con colores personalizados -->
    <style name="CustomButton.Green" parent="CustomButton.Primary">
        <item name="android:backgroundTint">#4CAF50</item>
    </style>

    <style name="CustomButton.Red" parent="CustomButton.Primary">
        <item name="android:backgroundTint">#F44336</item>
    </style>

    <style name="CustomButton.Gray" parent="CustomButton.Primary">
        <item name="android:backgroundTint">#9E9E9E</item>
    </style>

    <style name="CustomButton.Blue" parent="CustomButton.Primary">
        <item name="android:backgroundTint">#2196F3</item>
    </style>
</resources>
